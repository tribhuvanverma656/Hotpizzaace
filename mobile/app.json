{
  "expo": {
    "name": "Hot Pizza Ace",
    "slug": "hot-pizza-ace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hotpizzaace.customer"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F1",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hotpizzaace.customer"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font"
    ],
    "scheme": "hotpizzaace",
    "experiments": {
      "typedRoutes": true
    },
    "owner": "hotpizzaaces-team",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "209f84b5-eddb-4d73-bd25-b55fbc3e2276"
      }
    }
  }
}
