# Shared commerce uses the development Supabase project and hpa-commerce Edge Function.
# Copy to .env.local. Both values are public; never put secret/service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Keep password-link requests disabled until private SMTP and the fragment recovery
# email template are configured and validated. Only the exact value true enables them.
# This public flag is embedded during the build; rebuild after changing it.
NEXT_PUBLIC_PASSWORD_RECOVERY_ENABLED=false

# Enable only after applying migrations, seeding the catalog and deploying hpa-commerce.
# With false/absent, the existing browser-local demo is preserved.
COMMERCE_ENABLED=false

# Render provides PORT automatically. Local Next.js defaults to port 3000.
# Public values are embedded at build time; rebuild after changing projects.

# Optional canonical app origin for OAuth. Render supplies RENDER_EXTERNAL_URL automatically.
# For a custom domain, set APP_BASE_URL to its exact HTTPS origin without a path.
# APP_BASE_URL=https://hotpizzaace-development.onrender.com
# Google OAuth client ID/secret are stored in Supabase Auth provider settings, not here.
